[Unit]
Description=Open Bastion SSH fingerprint sink (per-deposit)
Documentation=https://github.com/linagora/open-bastion

[Service]
# One short-lived instance per deposit. systemd passes the connected socket as
# stdin AND stdout; the daemon reads the three-line request from fd 0 and
# writes its one-line verdict to fd 1.
ExecStart=/usr/sbin/ob-fp-daemon
StandardInput=socket
StandardOutput=socket
StandardError=journal
# Root is the point of this unit (#249): it owns /run/open-bastion/ssh-fp at
# 0700 so the shared `nobody` account can no longer read other sessions'
# fingerprints or forge a drop. It writes that directory and reads /proc; no
# capabilities beyond that are needed.
User=root

# Hardening. It talks to no network at all -- AF_UNIX for the activation
# socket, and that is the whole list.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateNetwork=true
ProtectControlGroups=true
ProtectKernelTunables=true
ProtectKernelModules=true
RestrictNamespaces=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX
MemoryDenyWriteExecute=true
UMask=0077
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# The spool is the only thing it writes. ProtectSystem=strict makes everything
# else read-only, so this line is what grants the one path it needs.
ReadWritePaths=/run/open-bastion
ReadOnlyPaths=/etc/open-bastion
# It must see the real process tree to derive the sshd anchor from the peer's
# ancestry, so /proc cannot be hidden or subset'd here.
ProcSubset=all
ProtectProc=default
