[Unit]
Description=Open Bastion Offline Session Monitor
Documentation=man:ob-session-monitor(8)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/sbin/ob-session-monitor
Restart=on-failure
RestartSec=30
User=root
Group=root

# Security hardening
NoNewPrivileges=yes
# /usr, /boot, /efi and /etc read-only except for the paths re-opened below.
# NOT ProtectSystem=strict: the monitor legitimately writes (and CREATES)
# /etc/open-bastion/force_online, and /var, /run must stay writable.
ProtectSystem=full
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes

# Requires read access to config and write access to runtime dir.
#
# The force_online file must be listed as its DIRECTORY, not as the file:
#  - the monitor appends with `>>`, which CREATES the file when it is missing,
#    and creating an entry needs the parent directory writable — a per-file
#    exception under a read-only /etc yields EROFS;
#  - systemd refuses to set up the namespace at all when a ReadWritePaths=
#    entry does not exist, so naming the file made the unit fail to start on
#    every host that had never gone offline.
# openbastion.conf stays read-only: ReadOnlyPaths= is applied after
# ReadWritePaths=, so the more specific entry wins.
ReadWritePaths=/run/open-bastion /etc/open-bastion
ReadOnlyPaths=/etc/open-bastion/openbastion.conf

# Network access required
PrivateNetwork=no

[Install]
WantedBy=multi-user.target
