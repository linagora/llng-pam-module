#!/bin/bash
#
# ob-post-upgrade - finish an Open Bastion package upgrade on this host
#
# Copyright (C) 2026 Linagora
# License: AGPL-3.0
#
# Installing the package is not always enough. Some of what a host needs lives
# outside the package: /usr/local/sbin/ob-ssh-principals is generated by
# ob-bastion-setup / ob-backend-setup, so `apt upgrade` replaces the daemon it
# talks to and leaves the helper as it was. Until now the only cure was
# "re-run the setup script with the arguments you used before" -- and an
# operator who deployed through ob-builder months ago does not have them.
#
# This command needs none. Everything it re-asserts is derivable from the host:
# the shipped helper text, the tmpfiles rule, the socket unit, the spool
# ownership. It reads /etc/open-bastion/openbastion.conf for one thing only --
# node_role, to pick the bastion or backend helper -- and writes nothing to it.
#
# What it deliberately does NOT do:
#
#   - enrol, or re-enrol. Re-enrolling mints a NEW device id, which no backend
#     allowlist contains, so every hop from this host would be refused. It is
#     the single most damaging thing an operator can do while trying to repair
#     one, and the name of this command was chosen so nobody would arrive here
#     expecting it.
#   - touch openbastion.conf, the server token, sshd_config, or any PAM stack.
#     Those carry decisions -- a server group, a mode, an --enable-* flag --
#     and a command that cannot know them must not guess.
#
# So it is safe to run on any host, at any time, as often as you like.

set -euo pipefail

VERSION="1.0.0"
PROG_NAME=$(basename "$0")

CONFIG_FILE="${OB_CONFIG:-/etc/open-bastion/openbastion.conf}"
HELPER_PATH="/usr/local/sbin/ob-ssh-principals"
SPOOL_DIR="/run/open-bastion/ssh-fp"
SPOOL_PARENT="/run/open-bastion"
TMPFILES_CONF="/etc/tmpfiles.d/open-bastion-ssh-fp.conf"

# Shipped data, with a source-tree fallback so this runs uninstalled too.
# Same idiom as ob-sign-lib.sh in the other scripts.
DATA_DIR="${OB_DATA_DIR:-/usr/lib/open-bastion}"
if [ ! -r "$DATA_DIR/ob-ssh-principals.bastion" ]; then
    _here="$(dirname "$(readlink -f "$0")")"
    [ -r "$_here/../share/ob-ssh-principals.bastion" ] && DATA_DIR="$_here/../share"
fi

DRY_RUN=false
CHANGED=0

if [ -t 1 ]; then
    RED=$'\033[0;31m'; GREEN=$'\033[0;32m'; YELLOW=$'\033[1;33m'
    BLUE=$'\033[0;34m'; NC=$'\033[0m'
else
    RED=''; GREEN=''; YELLOW=''; BLUE=''; NC=''
fi

info()  { echo "${BLUE}[INFO]${NC} $*"; }
ok()    { echo "${GREEN}[ OK ]${NC} $*"; }
warn()  { echo "${YELLOW}[WARN]${NC} $*" >&2; }
error() { echo "${RED}[FAIL]${NC} $*" >&2; }
act()   { CHANGED=$((CHANGED + 1)); echo "${GREEN}[DONE]${NC} $*"; }

usage() {
    cat <<EOF
Usage: $PROG_NAME [--dry-run]

Finishes an Open Bastion package upgrade on this host: re-installs the
generated sshd principals helper, its tmpfiles rule, and the fingerprint sink
socket, and takes the spool directory back to root.

Takes no configuration and asks no questions. It does not enrol, does not
re-enrol, and does not modify openbastion.conf, the server token, sshd_config
or any PAM stack -- so it is safe to run at any time, as often as you like.

Options:
  -n, --dry-run   Report what would change and change nothing
  -h, --help      This message
  -V, --version   Version

Exit status:
  0  the host is up to date (whether or not anything had to be done)
  1  something could not be repaired; the reason is on stderr
EOF
}

while [ $# -gt 0 ]; do
    case "$1" in
        -n|--dry-run) DRY_RUN=true; shift ;;
        -h|--help)    usage; exit 0 ;;
        -V|--version) echo "$PROG_NAME $VERSION"; exit 0 ;;
        *) error "Unknown option: $1"; usage >&2; exit 1 ;;
    esac
done

if [ "$(id -u)" -ne 0 ] && [ "$DRY_RUN" != "true" ]; then
    error "$PROG_NAME must run as root (it writes $HELPER_PATH and $TMPFILES_CONF)"
    exit 1
fi

# ── Which helper does this host need? ────────────────────────────────────────
# node_role is written by both setup scripts and is the only thing read here.
# A host with no config file has never been set up: repairing its helper would
# be meaningless, and the honest answer is to say so rather than install a
# bastion helper on something that may be a backend.
read_conf() {
    local key="$1"
    [ -r "$CONFIG_FILE" ] || return 1
    sed -n "s/^[[:space:]]*${key}[[:space:]]*=[[:space:]]*\\([^#]*\\).*/\\1/p" \
        "$CONFIG_FILE" | tail -1 | sed 's/[[:space:]]*$//'
}

detect_role() {
    local role
    role=$(read_conf node_role 2>/dev/null || true)
    case "$role" in
        backend)            echo backend ;;
        bastion|standalone) echo bastion ;;
        "")
            # Older hosts predate node_role. The backend is the one that reads
            # an allowlist, so its presence is the discriminator.
            if [ -e /etc/open-bastion/allowed_bastions ]; then
                echo backend
            else
                echo bastion
            fi
            ;;
        *) echo "unknown:$role" ;;
    esac
}

if [ ! -r "$CONFIG_FILE" ]; then
    error "No $CONFIG_FILE: this host has not been set up."
    error "Run ob-bastion-setup or ob-backend-setup first. $PROG_NAME repairs"
    error "an existing installation; it does not create one."
    exit 1
fi

ROLE=$(detect_role)
case "$ROLE" in
    unknown:*)
        error "node_role in $CONFIG_FILE is '${ROLE#unknown:}', which is not"
        error "bastion, standalone or backend. Fix it before repairing."
        exit 1 ;;
esac

HELPER_SRC="$DATA_DIR/ob-ssh-principals.$ROLE"
TMPFILES_SRC="$DATA_DIR/ob-fp-spool.tmpfiles"

echo
echo "Open Bastion post-upgrade repair — role: $ROLE"
[ "$DRY_RUN" = "true" ] && info "dry run: nothing will be changed"
echo

# ── 1. The generated principals helper ───────────────────────────────────────
if [ ! -r "$HELPER_SRC" ]; then
    error "Missing $HELPER_SRC (reinstall the open-bastion package)"
    exit 1
fi

if [ -e "$HELPER_PATH" ] && cmp -s "$HELPER_SRC" "$HELPER_PATH"; then
    ok "$HELPER_PATH is current"
else
    if [ "$DRY_RUN" = "true" ]; then
        info "would install the $ROLE helper at $HELPER_PATH"
    else
        [ -e "$HELPER_PATH" ] && cp -p "$HELPER_PATH" "$HELPER_PATH.bak-$(date +%Y%m%d%H%M%S)"
        install -D -m 0755 -o root -g root "$HELPER_SRC" "$HELPER_PATH"
        act "installed the $ROLE helper at $HELPER_PATH"
    fi
fi

# ── 2. The tmpfiles rule that recreates the spool after a reboot ─────────────
if [ -e "$TMPFILES_CONF" ] && cmp -s "$TMPFILES_SRC" "$TMPFILES_CONF"; then
    ok "$TMPFILES_CONF is current"
elif [ "$DRY_RUN" = "true" ]; then
    info "would install $TMPFILES_CONF"
else
    install -D -m 0644 -o root -g root "$TMPFILES_SRC" "$TMPFILES_CONF"
    act "installed $TMPFILES_CONF"
fi

# ── 3. The fingerprint sink socket ───────────────────────────────────────────
if ! command -v systemctl >/dev/null 2>&1; then
    warn "systemctl not available — enable ob-fp.socket yourself"
elif systemctl is-active --quiet ob-fp.socket 2>/dev/null; then
    ok "ob-fp.socket is active"
elif [ "$DRY_RUN" = "true" ]; then
    info "would enable and start ob-fp.socket"
elif systemctl enable --now ob-fp.socket >/dev/null 2>&1; then
    act "enabled ob-fp.socket"
else
    error "Could not enable ob-fp.socket."
    error "Without it the helper has nowhere to deposit: logins still succeed,"
    error "but with no SSH fingerprint binding. On a host with"
    error "fingerprint_required = true, or against a portal with"
    error "pamAccessRequireFingerprint, those logins are refused instead."
    exit 1
fi

# ── 4. The spool directory itself ────────────────────────────────────────────
# Before #249 this was 0700 nobody, because the helper wrote the drops itself.
# The daemon re-asserts root ownership on its first deposit, so a host converges
# on its next SSH login anyway -- but converging now is what makes the log line
# stop, and what lets an operator verify the repair without logging in again.
if [ ! -d "$SPOOL_DIR" ]; then
    if [ "$DRY_RUN" = "true" ]; then
        info "would create $SPOOL_DIR as 0700 root"
    else
        install -d -m 0711 -o root -g root "$SPOOL_PARENT"
        install -d -m 0700 -o root -g root "$SPOOL_DIR"
        act "created $SPOOL_DIR as 0700 root"
    fi
else
    owner=$(stat -c '%u' "$SPOOL_DIR")
    mode=$(stat -c '%a' "$SPOOL_DIR")
    if [ "$owner" = "0" ] && [ "$mode" = "700" ]; then
        ok "$SPOOL_DIR is 0700 root"
    elif [ "$DRY_RUN" = "true" ]; then
        info "would take $SPOOL_DIR from uid $owner mode $mode to 0700 root"
    else
        chown root:root "$SPOOL_DIR"
        chmod 0700 "$SPOOL_DIR"
        act "took $SPOOL_DIR from uid $owner mode $mode to 0700 root"
    fi
fi

echo
if [ "$DRY_RUN" = "true" ]; then
    info "dry run complete — nothing was changed"
elif [ "$CHANGED" -eq 0 ]; then
    ok "nothing to do: this host was already up to date"
else
    ok "$CHANGED item(s) repaired"
    echo
    info "To verify, log in with a public key from elsewhere, then:"
    info "  sudo find $SPOOL_DIR -name '*.fp' -newermt '-2 min'"
fi
exit 0
