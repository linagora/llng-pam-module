#!/bin/bash
#
# ob-bastion-id - Print this bastion's identifier (as seen by backends)
#
# After a bastion has been enrolled (ob-enroll + ob-bastion-setup) it can ask
# LLNG for its own identity (POST /pam/whoami). The returned 'bastion_id' is a
# synthetic per-device identity assigned by the portal at enrolment -- NOT the
# OIDC client_id, which identifies a project. It is the value backends list in
# /etc/open-bastion/allowed_bastions, and that ob-ssh-principals checks against
# the certificate key-id before PAM runs.
#
# This utility asks the portal and prints the bastion_id (or the whole response
# with --verbose). Useful when configuring a new backend that must restrict
# which bastions can reach it.
#
# Portals older than lemonldap-ng-plugins#94 have no /pam/whoami; against those
# it falls back to the legacy 'POST /pam/bastion-token {"probe":true}', which
# upstream removed in #86. The fallback exists so a mixed fleet keeps working
# during the upgrade, and can go once every portal has moved.
#
# Usage:
#   ob-bastion-id                    # prints bastion_id on stdout
#   ob-bastion-id --verbose          # full portal response as JSON
#   ob-bastion-id --json             # bastion_id wrapped in JSON (machine-readable)
#
# Copyright (C) 2026 Linagora
# License: AGPL-3.0

set -euo pipefail

VERSION="0.3.0"
PROG_NAME=$(basename "$0")

CONFIG_FILE="/etc/open-bastion/openbastion.conf"
TOKEN_FILE="/var/lib/open-bastion/token"
PORTAL_URL=""
SERVER_GROUP=""
VERIFY_SSL=true
TIMEOUT=10
VERBOSE=false
JSON_OUT=false
QUIET=false

# Set by main() once the token file has been read, consumed by pam_post().
SERVER_TOKEN=""
CURL_OPTS=()
# Filled by every pam_post() call.
HTTP_STATUS=""
BODY=""

log_info()  { [ "$QUIET" = "true" ] || printf '[INFO] %s\n' "$*" >&2; }
log_error() { printf '[ERROR] %s\n' "$*" >&2; }
die() { log_error "$*"; exit "${2:-1}"; }

usage() {
    cat <<EOF
$PROG_NAME $VERSION

Print this bastion's identifier (the 'bastion_id' LLNG assigned it at
enrolment). Run on a bastion that has been enrolled and configured.

The bastion_id is a synthetic per-device identity, NOT the OIDC client_id:
two bastions enrolled with the same client_id have different bastion_ids,
and re-enrolling a bastion gives it a new one.

Backends list these values, one per line (commas and semicolons also work),
in /etc/open-bastion/allowed_bastions -- managed by
'ob-backend-setup --allowed-bastions <ids>'. An empty file accepts any
vouched bastion; an absent file is legacy non-enforcing mode.

USAGE:
  $PROG_NAME [OPTIONS]

OPTIONS:
  -v, --verbose          Print the portal's whole response as pretty JSON
  -j, --json             Print {"bastion_id":"..."} for scripting
  -q, --quiet            Suppress informational logs (errors still go to stderr)
  -c, --config FILE      Path to openbastion.conf  (default: $CONFIG_FILE)
  -t, --token FILE       Path to server token file (default: $TOKEN_FILE)
  -h, --help             Show this help
  -V, --version          Print version

EXIT STATUS:
  0  bastion_id printed successfully
  1  configuration or token missing / unreadable
  2  the portal request failed or was refused
  3  the portal answered, but with no identity in it
EOF
    exit 0
}

# Read a key=value from openbastion.conf (mirrors ob-enroll's read_config).
read_config() {
    local key="$1" file="$2"
    [ -f "$file" ] || return 0
    grep -E "^\\s*${key}\\s*=" "$file" 2>/dev/null \
        | sed -E 's/^[^=]+=\s*//' \
        | sed -E 's/^["'\'']//' \
        | sed -E 's/["'\'']$//' \
        | sed -E 's/\s*#.*$//' \
        | tail -1 \
        || true
}

# Decode base64url to raw bytes (stdout). Pure bash + base64.
# base64url uses '-' and '_' where standard base64 uses '+' and '/'.
base64url_decode() {
    local s="$1"
    # Strip whitespace (CR/LF/tab/space) that may have been introduced
    # by sloppy HTTP intermediaries — base64 -d tolerates internal
    # newlines, but our padding calculation below uses ${#s} which would
    # otherwise be wrong.
    s="${s//[$' \t\r\n']/}"
    # Translate the base64url alphabet to standard base64 in one pass.
    # (Previous form `${s//_//}` was correct but easily misread as
    #  "delete _" by reviewers and static-analysis tools.)
    s=$(printf '%s' "$s" | tr '\-_' '+/')
    local pad=$(( (4 - ${#s} % 4) % 4 ))
    case "$pad" in
        1) s="${s}=" ;;
        2) s="${s}==" ;;
        3) s="${s}===" ;;
    esac
    printf '%s' "$s" | base64 -d 2>/dev/null
}

# POST a JSON body to a /pam/* endpoint. Sets HTTP_STATUS and BODY; returns
# non-zero only when the request never got an answer at all (DNS, TLS, timeout).
#
# Deliberately no `-f`: this call used to carry one, which made curl exit
# non-zero on any 4xx *and discard the body*, so the status could not be
# inspected and every portal-side refusal collapsed into the same opaque
# "Request failed". Telling 404 (portal upgraded, endpoint gone) from 403
# (endpoint present, caller refused) is exactly what the fallback below turns
# on, so the status has to survive.
pam_post() {
    local path="$1" payload="$2" response
    response=$(curl "${CURL_OPTS[@]}" \
        -X POST \
        -H "Authorization: Bearer $SERVER_TOKEN" \
        -H "Content-Type: application/json" \
        -w '\n__HTTP_STATUS__:%{http_code}' \
        -d "$payload" \
        "${PORTAL_URL}${path}" 2>&1) || {
            log_error "Request to $path failed: $response"
            return 1
        }
    HTTP_STATUS="${response##*__HTTP_STATUS__:}"
    BODY="${response%$'\n'__HTTP_STATUS__:*}"
    return 0
}

# Print the identity carried by a JSON document, then exit 0. Returns non-zero
# (without exiting) when the document has no identity to print, so the caller
# decides what that means. --verbose dumps the whole document instead, which is
# why this is not a jq one-liner at each call site: the endpoints answer three
# different shapes and each is worth showing as-is.
emit_id() {
    local body="$1" filter="$2" id
    if [ "$VERBOSE" = "true" ]; then
        printf '%s\n' "$body" | jq .
        exit 0
    fi
    id=$(printf '%s' "$body" | jq -r "$filter" 2>/dev/null) || return 1
    [ -n "$id" ] || return 1
    if [ "$JSON_OUT" = "true" ]; then
        jq -nc --arg id "$id" '{bastion_id: $id}'
    else
        printf '%s\n' "$id"
    fi
    exit 0
}

parse_args() {
    while [ $# -gt 0 ]; do
        case "$1" in
            -v|--verbose)  VERBOSE=true; shift ;;
            -j|--json)     JSON_OUT=true; shift ;;
            -q|--quiet)    QUIET=true; shift ;;
            -c|--config)   CONFIG_FILE="${2:?--config requires a path}"; shift 2 ;;
            -t|--token)    TOKEN_FILE="${2:?--token requires a path}"; shift 2 ;;
            -h|--help)     usage ;;
            -V|--version)  echo "$PROG_NAME $VERSION"; exit 0 ;;
            *) die "Unknown option: $1 (use --help)" ;;
        esac
    done
}

main() {
    parse_args "$@"

    command -v curl >/dev/null || die "curl is required"
    command -v jq   >/dev/null || die "jq is required"

    [ -r "$CONFIG_FILE" ] || die "Config file not readable: $CONFIG_FILE (run as root?)"

    PORTAL_URL=$(read_config "portal_url" "$CONFIG_FILE")
    SERVER_GROUP=$(read_config "server_group" "$CONFIG_FILE")
    local verify_ssl_raw
    verify_ssl_raw=$(read_config "verify_ssl" "$CONFIG_FILE")
    case "$verify_ssl_raw" in false|no|0) VERIFY_SSL=false ;; esac

    # Honour `server_token_file = ...` in the conf, falling back to the
    # canonical /var/lib/open-bastion/token when unset. Mirrors the PAM module
    # so ob-bastion-id reads the same file PAM does, without manual --token.
    if [ "$TOKEN_FILE" = "/var/lib/open-bastion/token" ]; then
        local conf_token_file
        conf_token_file=$(read_config "server_token_file" "$CONFIG_FILE")
        [ -n "$conf_token_file" ] && TOKEN_FILE="$conf_token_file"
    fi
    [ -r "$TOKEN_FILE" ]  || die "Token file not readable: $TOKEN_FILE (bastion not enrolled?)"

    [ -n "$PORTAL_URL" ]   || die "portal_url missing from $CONFIG_FILE"
    [ -n "$SERVER_GROUP" ] || die "server_group missing from $CONFIG_FILE"

    # Accept both formats the PAM module's token_manager_load_file accepts:
    #  1. Plain text bearer token (canonical, written by ob-enroll)
    #  2. JSON with .access_token (docker-demo entrypoints, refresh-token aware)
    local server_token
    if server_token=$(jq -er '.access_token' "$TOKEN_FILE" 2>/dev/null) \
       && [ -n "$server_token" ] && [ "$server_token" != "null" ]; then
        :  # JSON form, server_token is the .access_token value
    else
        server_token=$(tr -d '\r\n' < "$TOKEN_FILE")
    fi
    [ -n "$server_token" ] || die "Token file is empty or unparseable: $TOKEN_FILE"

    SERVER_TOKEN="$server_token"

    CURL_OPTS=( -sS --max-time "$TIMEOUT" -L )
    [ "$VERIFY_SSL" = "true" ] || CURL_OPTS+=( --insecure )

    # 1. POST /pam/whoami -- what answers this question on a current portal.
    #
    # It is a pure read: no JWT signed, no session written, no heartbeat stamp
    # (running ob-bastion-id must not make a bastion look freshly seen). The
    # response carries `server_id`, the canonical name, and `bastion_id`, the
    # name the old probe used, kept as an alias.
    log_info "Asking $PORTAL_URL/pam/whoami"
    pam_post /pam/whoami '{}' || exit 2

    if [ "$HTTP_STATUS" = "200" ]; then
        emit_id "$BODY" '.bastion_id // .server_id // empty' \
            || die "No bastion_id in /pam/whoami response: $BODY" 3
    fi

    # Anything but 404 is a real refusal (403 caller gate, 500, ...) and must
    # not be papered over by falling back to an endpoint that answers the same
    # way. 404 is the one status that means "this portal predates /pam/whoami".
    if [ "$HTTP_STATUS" != "404" ]; then
        log_error "LLNG returned HTTP $HTTP_STATUS on /pam/whoami: $BODY"
        exit 2
    fi

    # 2. Legacy fallback: POST /pam/bastion-token with probe:true.
    #
    # Removed upstream (lemonldap-ng-plugins#86) because it signed a JWT even
    # when the user lookup had failed, and /pam/whoami replaces the one part of
    # it worth keeping. Kept here only so this script still works against a
    # portal that has not been upgraded yet -- delete it once the fleet has.
    log_info "Portal has no /pam/whoami; falling back to the legacy" \
             "/pam/bastion-token probe (group=$SERVER_GROUP)"

    # user/target_host are harmless placeholders: probe mode returns the id
    # directly and skips the per-user _pamSeen recency gate that would
    # otherwise reject a synthetic probe user. Older portals answer a probe by
    # minting a placeholder JWT instead, which is why the JWT path survives.
    local payload
    payload=$(jq -n \
        --arg user "ob-bastion-id-probe" \
        --arg target_host "127.0.0.1" \
        --arg target_group "$SERVER_GROUP" \
        --arg bastion_group "$SERVER_GROUP" \
        '{user: $user, target_host: $target_host, target_group: $target_group, bastion_group: $bastion_group, probe: true}')

    pam_post /pam/bastion-token "$payload" || exit 2
    if [ "$HTTP_STATUS" != "200" ]; then
        log_error "LLNG returned HTTP $HTTP_STATUS on /pam/bastion-token: $BODY"
        exit 2
    fi

    # Probe mode returns bastion_id directly; prefer it when present.
    if printf '%s' "$BODY" | jq -e '.bastion_id // empty' >/dev/null 2>&1; then
        emit_id "$BODY" '.bastion_id // empty' \
            || die "No bastion_id in probe response: $BODY" 3
    fi

    local jwt
    jwt=$(printf '%s' "$BODY" | jq -r '.bastion_jwt // empty' 2>/dev/null)
    [ -n "$jwt" ] || die "No bastion_jwt in response: $BODY" 2

    # JWT is header.payload.signature -- decode the middle segment.
    local b64payload claims
    b64payload="${jwt#*.}"; b64payload="${b64payload%.*}"
    claims=$(base64url_decode "$b64payload")
    [ -n "$claims" ] || die "Failed to base64url-decode JWT payload" 3

    emit_id "$claims" '.bastion_id // .sub // empty' \
        || die "JWT has neither bastion_id nor sub claim" 3
}

main "$@"
